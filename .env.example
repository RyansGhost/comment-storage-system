# Copy to .env and fill in. Never commit .env.

# Public origin of the service (used in email links and CSRF checks).
PUBLIC_URL=https://comments.ryanfleck.ca

# Password for /admin. Leave empty to disable the admin GUI.
ADMIN_PASSWORD=change-me-to-something-long

# Behind Caddy/nginx: use X-Forwarded-For for rate limiting.
TRUST_PROXY=true

# Email: "ses" to send through Amazon SES, "log" to print emails to the log.
EMAIL_BACKEND=ses
SES_FROM=Ryan Fleck Comments <comments@ryanfleck.ca>
AWS_REGION=ca-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional:
# AWS_SESSION_TOKEN=
# SES_CONFIGURATION_SET=

# Optional: host port for docker-compose (default 8080).
# RF_COMMENTS_HOST_PORT=8080
